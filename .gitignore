# ==========================================
# SECURE CREDENTIALS & SENSITIVE FILES
# ==========================================
# Block all environment files across the entire workspace
.env
.env.*
*.env
**/.env

# ==========================================
# BACKEND & NODE PACKAGES
# ==========================================
# Block dependencies and compile build targets in the backend
node_modules/
**/node_modules/
dist/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# FLUTTER / DART RELATED (From tank_monitor)
# ==========================================
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/

# Symbolication & Obfuscation related
app.*.symbols
app.*.map.json

# Android Studio artifacts
/android/app/debug
/android/app/profile
/android/app/release
**/android/app/debug
**/android/app/profile
**/android/app/release

# ==========================================
# IDEs & SYSTEM MISCELLANEOUS
# ==========================================
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.idea/
*.iml
*.ipr
*.iws
.vscode/